{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "excludedCommands": ["gh"],
    "network": {
      "strictAllowlist": true,
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "nuget.org",
        "*.nuget.org"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "**/.env*", "mode": "deny" }
      ]
    }
  },
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(/**/.env*)",
      "Edit(/**/.env*)"
    ]
  }
}
