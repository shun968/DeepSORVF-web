# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node.js (commitlint/lefthook tooling)
node_modules/
npm-debug.log*

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# .NET build output
bin/
obj/

# Secrets
.env

# VS Code (keep only shared, non-machine-specific config)
.vscode/*
!.vscode/extensions.json

# dotnet CLI's file-based-app discovery cache (VS Code C# tooling; machine-local, auto-regenerated)
/dotnet/

# Local-only notes (design musings, scratch discussion) not meant to be committed or shared
/docs/local-notes/

# Model weights — attached to the weights-v1 GitHub Release, fetched by scripts/fetch-model-weights.sh
/deep_sort/deep_sort/deep/checkpoint/ckpt.t7
/detection_yolox/model_data/YOLOX-final.pth

# Test data and run outputs (clip-01's video/AIS, main.py results) — large, and not ours to redistribute
/tmp/
/clip-01/
/result/
